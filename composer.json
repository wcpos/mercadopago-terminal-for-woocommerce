{
  "name": "wcpos/mercadopago-terminal-for-woocommerce",
  "description": "Mercado Pago Point Smart terminal integration for WooCommerce POS.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [{"name": "kilbot", "email": "paul@kilbot.com"}],
  "require": {"php": ">=7.4", "ext-json": "*"},
  "require-dev": {"phpunit/phpunit": "^9.6"},
  "config": {"platform": {"php": "7.4"}, "platform-check": false, "sort-packages": true},
  "scripts": {
    "lint": "find . -path ./vendor -prune -o -path ./.worktrees -prune -o -name '*.php' -print -exec php -l {} \\;",
    "test": "phpunit --configuration phpunit.xml.dist",
    "test:js": "node tests/js/payment.test.js"
  },
  "autoload": {"psr-4": {"WCPOS\\WooCommercePOS\\MercadoPagoTerminal\\": "includes/"}}
}
